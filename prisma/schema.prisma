generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A Team is the account/tenant boundary. Everything is scoped to a Team
// from day one, even though today there is only one team.
model Team {
  id             String   @id @default(cuid())
  name           String
  departmentUnit String?
  logoDataUrl    String?  @db.Text
  createdAt      DateTime @default(now())

  users                User[]
  staff                Staff[]
  dutyCodes            DutyCode[]
  rotaEntries          RotaEntry[]
  leavePeriods         LeavePeriod[]
  nonOfficialRules     NonOfficialDayRule[]
  nonOfficialOverrides NonOfficialDayOverride[]
  dutyRequests         DutyRequest[]
  dutyExchanges        DutyExchange[]
}

enum UserRole {
  ADMIN
  STAFF
}

// A login account. Distinct from Staff (a roster row) -- a login may or
// may not correspond to a person on the roster.
model User {
  id           String   @id @default(cuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id])
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(STAFF)
  staffId      String?  @unique
  staff        Staff?   @relation(fields: [staffId], references: [id])
  createdAt    DateTime @default(now())
}

// A roster member. Never hard-deleted -- isActive controls whether they
// show up on new rotas, but historical RotaEntry rows always survive.
model Staff {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  name        String
  contactInfo String?
  designation String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User?
  rotaEntries  RotaEntry[]
  leavePeriods LeavePeriod[]
  dutyRequests DutyRequest[]
  exchangesAsInitiator DutyExchange[] @relation("ExchangeStaffA")
  exchangesAsPartner   DutyExchange[] @relation("ExchangeStaffB")

  @@index([teamId, sortOrder])
}

// A configurable shift/duty/leave code. category is free text and fully
// custom; isWorkingDay / isLeave are the machine-readable flags that drive
// coverage counts, non-official-day tracking, and leave reporting.
model DutyCode {
  id           String   @id @default(cuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id])
  code         String
  name         String
  color        String
  category     String
  isWorkingDay Boolean  @default(true)
  isLeave      Boolean  @default(false)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  rotaEntries  RotaEntry[]
  leavePeriods LeavePeriod[]
  dutyRequests DutyRequest[]
  exchangeSnapshotsA DutyExchange[] @relation("ExchangeStaffADuty")
  exchangeSnapshotsB DutyExchange[] @relation("ExchangeStaffBDuty")

  @@unique([teamId, code])
  @@index([teamId, sortOrder])
}

// One cell in the rota grid: a single staff member on a single date.
model RotaEntry {
  id              String       @id @default(cuid())
  teamId          String
  team            Team         @relation(fields: [teamId], references: [id])
  staffId         String
  staff           Staff        @relation(fields: [staffId], references: [id])
  date            DateTime     @db.Date
  dutyCodeId      String
  dutyCode        DutyCode     @relation(fields: [dutyCodeId], references: [id])
  leavePeriodId   String?
  leavePeriod     LeavePeriod? @relation(fields: [leavePeriodId], references: [id])
  note            String?
  updatedByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([teamId, staffId, date])
  @@index([teamId, date])
}

// A multi-day leave booking. Auto-fills RotaEntry rows for its range;
// editing a single day inside the range detaches that RotaEntry from the
// period (leavePeriodId -> null) without deleting it.
model LeavePeriod {
  id         String   @id @default(cuid())
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id])
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id])
  dutyCodeId String
  dutyCode   DutyCode @relation(fields: [dutyCodeId], references: [id])
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  note       String?
  createdAt  DateTime @default(now())

  rotaEntries RotaEntry[]

  @@index([teamId, staffId])
}

// "All Fridays are non-official" style rule.
model NonOfficialDayRule {
  id      String  @id @default(cuid())
  teamId  String
  team    Team    @relation(fields: [teamId], references: [id])
  weekday Int     // 0 = Sunday .. 6 = Saturday
  enabled Boolean @default(true)

  @@unique([teamId, weekday])
}

// Manual toggle for one specific date, overriding the weekday rule.
model NonOfficialDayOverride {
  id            String   @id @default(cuid())
  teamId        String
  team          Team     @relation(fields: [teamId], references: [id])
  date          DateTime @db.Date
  isNonOfficial Boolean

  @@unique([teamId, date])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// A staff member's request to be put on a specific duty code on a specific
// date (a normal duty, or an "Off"/leave-type code -- both are just duty
// codes, so one model covers both). Approving one writes straight into
// RotaEntry, same as a manual grid edit.
model DutyRequest {
  id              String        @id @default(cuid())
  teamId          String
  team            Team          @relation(fields: [teamId], references: [id])
  staffId         String
  staff           Staff         @relation(fields: [staffId], references: [id])
  date            DateTime      @db.Date
  dutyCodeId      String
  dutyCode        DutyCode      @relation(fields: [dutyCodeId], references: [id])
  note            String?
  status          RequestStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  decidedAt       DateTime?
  decidedByUserId String?

  @@index([teamId, staffId])
  @@index([teamId, status])
}

enum ExchangeStatus {
  PENDING_PARTNER
  PENDING_ADMIN
  APPROVED
  REJECTED
}

// A staff-to-staff proposal to swap whatever each has on a given date.
// staffA is the initiator (auto-approved by creating it); staffB is the
// partner who must accept; once both have agreed an admin gives final
// approval, which is when the actual RotaEntry swap happens. The duty
// each side had at proposal time is snapshotted so the swap is
// predictable even if the grid changes in the meantime.
model DutyExchange {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id])
  date   DateTime @db.Date

  staffAId String
  staffA   Staff  @relation("ExchangeStaffA", fields: [staffAId], references: [id])
  staffBId String
  staffB   Staff  @relation("ExchangeStaffB", fields: [staffBId], references: [id])

  staffADutyCodeId String?
  staffADutyCode   DutyCode? @relation("ExchangeStaffADuty", fields: [staffADutyCodeId], references: [id])
  staffBDutyCodeId String?
  staffBDutyCode   DutyCode? @relation("ExchangeStaffBDuty", fields: [staffBDutyCodeId], references: [id])

  status          ExchangeStatus @default(PENDING_PARTNER)
  note            String?
  createdAt       DateTime       @default(now())
  partnerDecidedAt DateTime?
  adminDecidedAt  DateTime?
  decidedByUserId String?

  @@index([teamId, staffAId])
  @@index([teamId, staffBId])
  @@index([teamId, status])
}
