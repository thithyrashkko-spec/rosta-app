generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  id             String   @id @default(cuid())
  name           String
  departmentUnit String?
  logoDataUrl    String?  @db.Text
  createdAt      DateTime @default(now())

  users                User[]
  staff                Staff[]
  dutyCodes            DutyCode[]
  rotaEntries          RotaEntry[]
  leavePeriods         LeavePeriod[]
  nonOfficialRules     NonOfficialDayRule[]
  nonOfficialOverrides NonOfficialDayOverride[]
  dutyRequests         DutyRequest[]
  dutyExchanges        DutyExchange[]
}

enum UserRole {
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(cuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id])
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(STAFF)
  staffId      String?  @unique
  staff        Staff?   @relation(fields: [staffId], references: [id])
  createdAt    DateTime @default(now())
}

model Staff {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  name        String
  contactInfo String?
  designation String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User?
  rotaEntries  RotaEntry[]
  leavePeriods LeavePeriod[]
  dutyRequests DutyRequest[]
  exchangesAsInitiator DutyExchange[] @relation("ExchangeStaffA")
  exchangesAsPartner   DutyExchange[] @relation("ExchangeStaffB")

  @@index([teamId, sortOrder])
}

model DutyCode {
  id           String   @id @default(cuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id])
  code         String
  name         String
  color        String
  category     String
  isWorkingDay Boolean  @default(true)
  isLeave      Boolean  @default(false)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  rotaEntries  RotaEntry[]
  leavePeriods LeavePeriod[]
  dutyRequests DutyRequest[]
  exchangeSnapshotsA DutyExchange[] @relation("ExchangeStaffADuty")
  exchangeSnapshotsB DutyExchange[] @relation("ExchangeStaffBDuty")

  @@unique([teamId, code])
  @@index([teamId, sortOrder])
}

model RotaEntry {
  id              String       @id @default(cuid())
  teamId          String
  team            Team         @relation(fields: [teamId], references: [id])
  staffId         String
  staff           Staff        @relation(fields: [staffId], references: [id])
  date            DateTime     @db.Date
  dutyCodeId      String
  dutyCode        DutyCode     @relation(fields: [dutyCodeId], references: [id])
  leavePeriodId   String?
  leavePeriod     LeavePeriod? @relation(fields: [leavePeriodId], references: [id])
  note            String?
  updatedByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([teamId, staffId, date])
  @@index([teamId, date])
}

model LeavePeriod {
  id         String   @id @default(cuid())
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id])
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id])
  dutyCodeId String
  dutyCode   DutyCode @relation(fields: [dutyCodeId], references: [id])
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  note       String?
  createdAt  DateTime @default(now())

  rotaEntries RotaEntry[]

  @@index([teamId, staffId])
}

model NonOfficialDayRule {
  id      String  @id @default(cuid())
  teamId  String
  team    Team    @relation(fields: [teamId], references: [id])
  weekday Int
  enabled Boolean @default(true)

  @@unique([teamId, weekday])
}

model NonOfficialDayOverride {
  id            String   @id @default(cuid())
  teamId        String
  team          Team     @relation(fields: [teamId], references: [id])
  date          DateTime @db.Date
  isNonOfficial Boolean

  @@unique([teamId, date])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model DutyRequest {
  id              String        @id @default(cuid())
  teamId          String
  team            Team          @relation(fields: [teamId], references: [id])
  staffId         String
  staff           Staff         @relation(fields: [staffId], references: [id])
  date            DateTime      @db.Date
  dutyCodeId      String
  dutyCode        DutyCode      @relation(fields: [dutyCodeId], references: [id])
  note            String?
  status          RequestStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  decidedAt       DateTime?
  decidedByUserId String?

  @@index([teamId, staffId])
  @@index([teamId, status])
}

enum ExchangeStatus {
  PENDING_PARTNER
  PENDING_ADMIN
  APPROVED
  REJECTED
}

model DutyExchange {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id])
  date   DateTime @db.Date

  staffAId String
  staffA   Staff  @relation("ExchangeStaffA", fields: [staffAId], references: [id])
  staffBId String
  staffB   Staff  @relation("ExchangeStaffB", fields: [staffBId], references: [id])

  staffADutyCodeId String?
  staffADutyCode   DutyCode? @relation("ExchangeStaffADuty", fields: [staffADutyCodeId], references: [id])
  staffBDutyCodeId String?
  staffBDutyCode   DutyCode? @relation("ExchangeStaffBDuty", fields: [staffBDutyCodeId], references: [id])

  status          ExchangeStatus @default(PENDING_PARTNER)
  note            String?
  createdAt       DateTime       @default(now())
  partnerDecidedAt DateTime?
  adminDecidedAt  DateTime?
  decidedByUserId String?

  @@index([teamId, staffAId])
  @@index([teamId, staffBId])
  @@index([teamId, status])
}